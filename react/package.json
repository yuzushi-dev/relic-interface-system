{
  "name": "@relic-ui/react",
  "version": "2.8.0",
  "description": "Tactical cyber React + TypeScript UI Kit for Relic Interface System (RIS v2). Fully typed, WCAG 2.2 AA compliant, Emil Kowalski motion principles.",
  "author": "Relic Interface System Team",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "relic-ui",
    "tactical-cyber",
    "cyberpunk",
    "hud",
    "react",
    "typescript",
    "ui-kit",
    "wcag-aa",
    "zero-reflow"
  ]
}
