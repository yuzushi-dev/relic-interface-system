{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "RIS — Relic Interface System v2 Design Tokens. Tokens Studio for Figma & W3C DTCG Format.",
  "global": {
    "fontFamily": {
      "display": {
        "$type": "fontFamily",
        "$value": "Archivo",
        "$description": "Off-genre grotesk for display, headings, and HUD numerics"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "Archivo",
        "$description": "Body copy, labels, UI text"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono",
        "$description": "Metadata, telemetry, code, logs"
      },
      "cyber-display": {
        "$type": "fontFamily",
        "$value": "Chakra Petch",
        "$description": "Tactical Cyber HUD display typeface"
      }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "fontSize": {
      "3xl": { "$type": "dimension", "$value": "44px", "$description": "Hero display numbers & headings" },
      "2xl": { "$type": "dimension", "$value": "32px", "$description": "H1 page headings" },
      "xl": { "$type": "dimension", "$value": "24px", "$description": "H2 section headings" },
      "lg": { "$type": "dimension", "$value": "19px", "$description": "H3 card titles & large values" },
      "md": { "$type": "dimension", "$value": "16px", "$description": "Body base size" },
      "sm": { "$type": "dimension", "$value": "14px", "$description": "Small text, secondary UI labels" },
      "xs": { "$type": "dimension", "$value": "11px", "$description": "Floor — hard metadata only" }
    },
    "lineHeight": {
      "3xl": { "$type": "dimension", "$value": "44px" },
      "2xl": { "$type": "dimension", "$value": "34px" },
      "xl": { "$type": "dimension", "$value": "26px" },
      "lg": { "$type": "dimension", "$value": "22px" },
      "md": { "$type": "dimension", "$value": "25px" },
      "sm": { "$type": "dimension", "$value": "21px" },
      "xs": { "$type": "dimension", "$value": "11px" }
    },
    "letterSpacing": {
      "tight": { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.08em" },
      "wider": { "$type": "dimension", "$value": "0.16em" },
      "max": { "$type": "dimension", "$value": "0.28em" }
    },
    "space": {
      "s1": { "$type": "dimension", "$value": "4px", "$description": "Base grid unit" },
      "s2": { "$type": "dimension", "$value": "8px" },
      "s3": { "$type": "dimension", "$value": "12px" },
      "s4": { "$type": "dimension", "$value": "16px" },
      "s5": { "$type": "dimension", "$value": "20px" },
      "s6": { "$type": "dimension", "$value": "24px" },
      "s7": { "$type": "dimension", "$value": "32px" },
      "s8": { "$type": "dimension", "$value": "48px" }
    },
    "shape": {
      "radius": {
        "$type": "dimension",
        "$value": "0px",
        "$description": "Hard-edged; corners are clipped, never rounded"
      },
      "chamfer-sm": {
        "$type": "dimension",
        "$value": "6px",
        "$description": "45° chamfer cut for chips, inputs, buttons"
      },
      "chamfer-md": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "45° chamfer cut for panels, cards"
      },
      "chamfer-lg": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "45° chamfer cut for modals, hero blocks"
      }
    },
    "layout": {
      "topbarHeight": { "$type": "dimension", "$value": "52px" },
      "railWidth": { "$type": "dimension", "$value": "64px" },
