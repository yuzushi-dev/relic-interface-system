        "cyan": { "$type": "color", "$value": "#00e5ff" },
        "green": { "$type": "color", "$value": "#00e57e" },
        "yellow": { "$type": "color", "$value": "#ffe23a" },
        "violet": { "$type": "color", "$value": "#9a5cff" },
        "magenta": { "$type": "color", "$value": "#ff42c8" },
        "orange": { "$type": "color", "$value": "#ff9230" }
      }
    }
