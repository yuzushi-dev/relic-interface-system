        "cyan": { "$type": "color", "$value": "#6fb3c9", "$description": "Steel-ice — data/link/scan" },
        "red": { "$type": "color", "$value": "#d45565" },
        "green": { "$type": "color", "$value": "#5fae84" },
        "violet": { "$type": "color", "$value": "#8479be" },
        "magenta": { "$type": "color", "$value": "#b274c0", "$description": "Orchid — Gumi runtime" },
        "orange": { "$type": "color", "$value": "#d08a4e" }
